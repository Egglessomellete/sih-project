# ── Environment Variables Example ──
# Copy this file to .env before starting the services

# --- API Configuration ---
APP_NAME="SIH Jharkhand Portal API"
DEBUG=true

# --- Database ---
DATABASE_URL="sqlite:///./sih.db"

# --- Authentication ---
JWT_SECRET="demo-secret-key-change-in-production-12345"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=1440

# --- File Uploads ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=20971520

# --- Web Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:8000"
